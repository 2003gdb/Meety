# Photon iMessage line users text after signup (E.164, e.g. +14155550123)
NEXT_PUBLIC_PHOTON_NUMBER=

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://fobnnyklnsnpltxisiph.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fallback origin for magic-link redirects (set to the Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: tavily-research looks up each new sign-up (src/lib/research.ts).
# Service key: Supabase Project Settings → API → secret key. Never NEXT_PUBLIC_.
SUPABASE_URL=https://fobnnyklnsnpltxisiph.supabase.co
SUPABASE_SERVICE_KEY=
TAVILY_API_KEY=
# Optional: better summaries. Without it a heuristic fallback is used.
GMI_API_KEY=

# Server-only: /welcome adds each user to the Photon project (Pro plan allowlist) and
# shows the line Photon assigned them. Photon dashboard → project → Settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Server-only: /connect-luma shows the Luma sign-in the bot opened in Browserbase.
BROWSERBASE_API_KEY=
