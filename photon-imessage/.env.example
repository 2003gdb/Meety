# Photon Spectrum project (app.photon.codes -> project Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# "imessage" (default) or "terminal" for local dev without Photon credentials
MEETY_TRANSPORT=imessage

# Landing page URL sent to anyone who texts before signing up
MEETY_SIGNUP_URL=https://meety.example.com

# HTTP port for the handoff / notify endpoints other lanes call
MEETY_HTTP_PORT=8787
# Optional shared secret; if set, callers must send it as the x-meety-secret header
MEETY_INTERNAL_SECRET=

# Conversation brain (optional; falls back to rules when unset)
ANTHROPIC_API_KEY=
MEETY_BRAIN_MODEL=claude-haiku-4-5

# How long to wait for a burst of texts to settle before replying (ms)
MEETY_DEBOUNCE_MS=2500
